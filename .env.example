# Local PostgreSQL. Never expose this value with a VITE_ prefix.
DATABASE_URL=postgresql://orbit:orbit_local_password@127.0.0.1:5433/orbit

# Generate a unique value for every environment: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
APP_URL=http://localhost:8080
VITE_APP_URL=http://localhost:8080
# Comma-separated additional origins, such as a LAN URL used for device testing.
TRUSTED_ORIGINS=

# Optional local seed account overrides.
SEED_USER_EMAIL=demo@orbit.local
SEED_USER_NAME=Orbit Demo
SEED_USER_PASSWORD=OrbitDemo123!

# smtp: local Mailpit; log: metadata only; test: Mailgun test mode; send: real delivery
MAIL_MODE=smtp
MAIL_SMTP_HOST=127.0.0.1
MAIL_SMTP_PORT=1025
MAILGUN_API_KEY=
MAILGUN_WEBHOOK_SIGNING_KEY=
MAILGUN_DOMAIN=mg.example.com
MAILGUN_BASE_URL=https://api.mailgun.net
MAIL_FROM=Orbit <notifications@mg.example.com>
CRON_SECRET=replace-with-another-random-secret
HR_WEBHOOK_SECRET=
