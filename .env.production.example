# Copy this file to .env.production on the server and replace every CHANGE_ME value.
# Use a hexadecimal PostgreSQL password so it is safe inside DATABASE_URL.
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD

DATABASE_SSL=false
BETTER_AUTH_SECRET=CHANGE_ME_AUTH_SECRET
CRON_SECRET=CHANGE_ME_CRON_SECRET

APP_URL=http://pms.helapay.africa
VITE_APP_URL=http://pms.helapay.africa
TRUSTED_ORIGINS=http://pms.helapay.africa

MAIL_MODE=smtp
MAIL_SMTP_HOST=nexus-01.webstacloud.com
MAIL_SMTP_PORT=587
MAIL_SMTP_SECURE=false
MAIL_SMTP_REQUIRE_TLS=true
MAIL_SMTP_USER=no-reply@helapay.africa
MAIL_SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD
MAIL_SMTP_TIMEOUT=30000
MAIL_FROM="Orbit <no-reply@helapay.africa>"

HR_WEBHOOK_SECRET=
